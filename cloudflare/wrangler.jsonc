{
  "name": "agent-inboxes",
  "main": "src/entry.py",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "Workspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Workspace"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "WORKSPACE": "team",
    "WORKSPACE_NAME": "Your workspace",
    "MEMBERS": "nate.mcguire@gmail.com",
    "SSO_ORIGIN": "https://auth.nates-software.com",
    "SSO_APP_ID": "agent-inboxes",
    "SSO_TENANT_ID": "nates-software"
  },
  "build": {
    "command": "python3 build.py"
  },
  "services": [
    {
      "binding": "AUTH_HUB",
      "service": "auth"
    }
  ]
}
